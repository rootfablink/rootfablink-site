NODE_ENV=production

# Public web URL
NEXT_PUBLIC_APP_URL="https://rootfablink.com"
NEXT_PUBLIC_SITE_URL="https://rootfablink.com"
WEB_ORIGIN="https://rootfablink.com"
CORS_ALLOWED_ORIGINS="https://rootfablink.com,https://www.rootfablink.com"
ROOTFABLINK_ROUTE_PROTECTION_MODE="enforce"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rootfablink?schema=public"

# Authentication and API secrets
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://rootfablink.com"
JWT_SECRET="replace-with-a-long-random-secret"
ENCRYPTION_KEY="replace-with-a-32-byte-minimum-random-key"

# Rate limiting and abuse protection
REDIS_URL="redis://USER:PASSWORD@HOST:6379"

# Upload and private document storage
UPLOAD_PROVIDER="s3"
STORAGE_BUCKET="rootfablink-production"
STORAGE_REGION="eu-central-1"
STORAGE_ACCESS_KEY_ID="replace-with-server-side-storage-access-key-id"
STORAGE_SECRET_ACCESS_KEY="replace-with-server-side-storage-secret-access-key"

# Email delivery
EMAIL_SERVER="smtp://USER:PASSWORD@HOST:587"
EMAIL_FROM="RootFabLink <security@rootfablink.com>"
